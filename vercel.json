{
  "version": 2,
  "framework": null,
  "buildCommand": "node patch-vercel.cjs && vite build",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "/index\\.php(/.*)?",
      "dest": "/api/index.php"
    },
    {
      "src": "/public/(.*)",
      "dest": "/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_KEY": "base64:sEMiMy2kiu9CAZ/+n3FNno6Hdq66cdT9jqSkxxHaHF8=",
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "APP_CONFIG_CACHE": "/tmp/storage/bootstrap/cache/config.php",
    "APP_EVENTS_CACHE": "/tmp/storage/bootstrap/cache/events.php",
    "APP_PACKAGES_CACHE": "/tmp/storage/bootstrap/cache/packages.php",
    "APP_ROUTES_CACHE": "/tmp/storage/bootstrap/cache/routes.php",
    "APP_SERVICES_CACHE": "/tmp/storage/bootstrap/cache/services.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "CACHE_STORE": "array",
    "CACHE_DRIVER": "array",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie"
  }
}
